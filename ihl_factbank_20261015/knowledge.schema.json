{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge.jsonl每一行的记录结构",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "statement_zh",
    "source_refs",
    "verified_on"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(R[0-9]{3}|F[0-9]{3}|T_(ISR|IRN)_[A-Z0-9_]+)$"
    },
    "record_type": {
      "enum": [
        "rule",
        "treaty_status",
        "state_declaration",
        "domestic_law",
        "official_position",
        "heritage_fact",
        "event_fact",
        "administrative_fact",
        "evidence_gap",
        "institutional_status"
      ]
    },
    "statement_zh": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verified_on": {
      "type": "string",
      "format": "date"
    },
    "event_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "evidence_status": {
      "type": "string"
    },
    "normative_type": {
      "type": "string"
    },
    "country_application": {
      "type": "object",
      "required": [
        "ISR",
        "IRN"
      ]
    },
    "is_party": {
      "type": "boolean"
    },
    "deposit_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "rule"
          }
        }
      },
      "then": {
        "required": [
          "instrument",
          "article",
          "normative_type",
          "conflict_scope",
          "country_application",
          "conditions",
          "needed_evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "treaty_status"
          }
        }
      },
      "then": {
        "required": [
          "country",
          "instrument",
          "is_party",
          "deposit_date",
          "signature_date",
          "entry_into_force_date",
          "valid_at_snapshot"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "not": {
              "enum": [
                "rule",
                "treaty_status"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "countries",
          "evidence_status",
          "uncertainty",
          "does_not_establish",
          "assertion_level"
        ]
      }
    }
  ],
  "$comment": "每条source_id须在sources.json存在；本schema验证结构，不验证中文法律命题是否成立。"
}
